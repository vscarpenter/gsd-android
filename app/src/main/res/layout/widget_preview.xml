<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (spec §12.1): the header with the crosshair, then sample rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_focus"
            android:tint="@color/widget_rust" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_title"
            android:textColor="@color/widget_rust"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_preview_task_1"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_preview_task_2"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_preview_task_3"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />
</LinearLayout>
